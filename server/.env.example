# Porta em que a API vai rodar
PORT=3333

# Segredo usado para assinar os tokens JWT.
# Em produção, troque por um texto longo e aleatório e NUNCA suba o .env para o GitHub.
JWT_SECRET=troque-este-segredo

# Caminho do arquivo do banco SQLite (é criado automaticamente)
DATABASE_PATH=./data/optimik.db
